					skills_cat_languages: "Lenguajes de Programación",
					skills_cat_tools: "Herramientas de Análisis",
					skills_cat_viz: "Visualización de Datos",
					skills_cat_cloud: "Cloud Computing",
					skills_cat_methods: "Estadística",
					skills_cat_db: "Bases de Datos",
					proj_1_title: "OPTIMIZACIÓN DE PRECIOS DE UBER",
					proj_1_subtitle: "EN LA CIUDAD DE NUEVA YORK",
					proj_1_desc:
						'Un análisis de extremo a extremo sobre <span class="text-white font-bold border-b border-white/40 pb-0.5">encontrar el mejor modelo de precios</span> para las reservas de Uber en la ciudad de Nueva York <span class="text-white font-bold border-b border-white/40 pb-0.5">para aumentar los ingresos</span> realizando una <span class="text-white font-bold border-b border-white/40 pb-0.5">Regresión Lineal</span> para encontrar el impacto de cada variable, evaluar el modelo de precios existente (aplicación de Tarifa Alta y Tarifa con Descuento), realizar un análisis de impacto y dar recomendaciones. Este análisis <span class="text-white font-bold border-b border-white/40 pb-0.5">resultó en un mejor modelo de precios de Uber</span> que demostró <span class="text-white font-bold border-b border-white/40 pb-0.5">aumentar los ingresos en un 11.5%</span>.',
					proj_2_title: "SEGMENTACIÓN DE CLIENTES",
