		<link rel="icon" type="image/png" href="/Icon-R.png" />
		<link rel="apple-touch-icon" href="/Icon-R.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<Preloader />
		<div id="custom-cursor" class="custom-cursor"></div>
