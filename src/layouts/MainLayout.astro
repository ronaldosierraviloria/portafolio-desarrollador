			let currentLang = localStorage.getItem("lang") || "es";

			function updateLanguage(lang, animate = false) {
				currentLang = lang;
				localStorage.setItem("lang", lang);

				// Update all elements with data-i18n attribute
				document.querySelectorAll("[data-i18n]").forEach((el) => {
					const key = el.getAttribute("data-i18n");
					if (translations[lang] && translations[lang][key]) {
						if (animate) {
							// Fade animation only when user manually toggles language
							gsap.to(el, {
								opacity: 0,
								duration: 0.15,
								onComplete: () => {
									el.innerHTML = translations[lang][key];
									gsap.to(el, { opacity: 1, duration: 0.15 });
								},
							});
						} else {
							el.innerHTML = translations[lang][key];
						}
					}
				});

				// Update lang toggle button text
				const langToggle = document.getElementById("lang-toggle");
				if (langToggle) {
					langToggle.innerHTML = `<span>${lang === "es" ? "EN" : "ES"}</span>`;
				}

				// Update HTML lang attribute
				document.documentElement.lang = lang;
			}

			// Initialize on DOM ready without layout animation conflict
			window.addEventListener("DOMContentLoaded", () => {
				updateLanguage(currentLang, false);
			});

			// Expose to window for the Navbar button
			window.toggleLanguage = () => {
				const newLang = currentLang === "es" ? "en" : "es";
				updateLanguage(newLang, true);
			};

			// --- Cursor Logic ---
			const cursor = document.getElementById("custom-cursor");
			if (window.matchMedia("(pointer: fine)").matches) {
				gsap.set(cursor, {
					x: window.innerWidth / 2,
					y: window.innerHeight / 2,
				});

				window.addEventListener("mousemove", (e) => {
					gsap.to(cursor, {
						x: e.clientX - 40,
						y: e.clientY - 40,
						duration: 0.15,
						ease: "power2.out",
					});
				});
			} else {
				if (cursor) cursor.style.display = "none";
			}
		</script>
