					proj_2_desc:
						'Un análisis exhaustivo centrado en el <span class="text-white font-bold border-b border-white/40 pb-0.5">comportamiento de compra de los clientes</span> utilizando el análisis RFM (Recencia, Frecuencia, Monetario) y el <span class="text-white font-bold border-b border-white/40 pb-0.5">Clúster K-Means</span> para agrupar a los clientes en distintos segmentos. Esto permitió al equipo de marketing <span class="text-white font-bold border-b border-white/40 pb-0.5">personalizar las campañas de forma eficaz</span>, lo que resultó en un <span class="text-white font-bold border-b border-white/40 pb-0.5">aumento del 20% en la retención</span>.',
					proj_link_deck: "Presentación Completa",
					proj_link_tableau: "Dashboard en Tableau",
					proj_link_colab: "Google Colab",
					proj_link_study: "Caso de Estudio",
					proj_link_powerbi: "Dashboard en Power BI",
