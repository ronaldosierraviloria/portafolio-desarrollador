---
import Preloader from "../components/Preloader.astro";
const { title, description = "Portafolio profesional de Ronaldo Sierra — Ingeniero de Sistemas, Desarrollador Full Stack Jr & Analista de Datos. Especializado en React, Python, AWS, bases de datos y soluciones web modernas." } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://ronaldosierra.dev");
const siteImage = new URL("/Icon-R.png", canonicalURL).href;

const personSchema = {
	"@context": "https://schema.org",
	"@type": "Person",
	"name": "Ronaldo Sierra",
	"jobTitle": "Full Stack Developer Jr & Ingeniero de Sistemas",
	"url": canonicalURL.href,
	"sameAs": [
		"https://github.com/ronaldosierraviloria"
	],
	"knowsAbout": [
		"Software Development",
		"Full Stack Development",
		"React",
		"Python",
		"AWS",
		"Laravel",
		"Docker",
		"Data Analysis",
		"PostgreSQL",
		"MySQL"
	],
	"description": description
};
