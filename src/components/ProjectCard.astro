---
export interface Props {
    project: {
        id: string;
        title: string;
        subtitle: string;
        images: string[];
        descriptionHtml: string;
        tools: string;
        analysis: string;
        links: {
            text: string;
            i18nKey: string;
            url: string;
        }[];
    };
}
const { project } = Astro.props;
const hasSlider = project.images.length > 1;
---

<div
    class="w-full relative flex flex-col xl:flex-row gap-8 xl:gap-16 border-b border-white/10 pb-24 group"
>
    <!-- Big ID Background / Sidebar -->
    <div
        class="w-full xl:w-1/4 flex flex-col md:flex-row xl:flex-col justify-between xl:justify-start items-start gap-4"
    >
        <span
            class="text-white/10 text-[6rem] md:text-[8rem] xl:text-[10rem] font-['Beastly'] leading-none tracking-tighter select-none transition-colors duration-500 group-hover:text-white/30"
            >{project.id}
        </span>

        <div class="mt-0 xl:mt-8 flex flex-col gap-2">
            <span
                class="inline-block border border-white/20 px-4 py-1 rounded-full text-[10px] uppercase tracking-[0.2em] font-mono text-white/50 w-max"
                data-i18n="proj_featured"
            >
                Proyecto Destacado
            </span>
        </div>
    </div>

    <!-- Content -->
    <div class="w-full xl:w-3/4 flex flex-col">
        <!-- Title -->
        <div class="mb-8">
            <h2
                class="text-white text-2xl md:text-4xl font-bold uppercase tracking-widest leading-tight"
                data-i18n={`proj_${project.id}_title`}
            >
                {project.title}
            </h2>
            <h3
                class="text-white/50 text-xl md:text-2xl font-mono uppercase tracking-[0.2em] mt-2"
                data-i18n={`proj_${project.id}_subtitle`}
            >
                {project.subtitle}
            </h3>
        </div>

        <!-- Image Slider -->
        <div
            class={`relative w-full mb-10 bg-white/5 border border-white/10 overflow-hidden ${
                hasSlider ? "h-[250px] md:h-[380px]" : "h-[200px] md:h-[300px]"
            }`}
            data-slider={hasSlider ? "true" : "false"}
        >
            <!-- Slides Container -->
            <div class="slider-track flex h-full transition-transform duration-500 ease-out">
                {project.images.filter(Boolean).map((img, i) => {
                    const isVideo = typeof img === 'string' && img.endsWith('.mp4');
                    return (
                        <div class="slider-slide w-full h-full flex-shrink-0 relative">
                            {isVideo ? (
                                <div class="w-full h-full flex items-center justify-center bg-black">
                                    <video
                                        class="max-w-full max-h-full object-contain"
                                        controls
                                        muted
                                        playsinline
                                        preload="auto"
                                    >
                                        <source src={img} type="video/mp4" />
                                    </video>
                                </div>
                            ) : (
                                <img
                                    src={img}
                                    alt={`Captura ${i + 1} - ${project.title}`}
                                    loading="lazy"
                                    decoding="async"
                                    class="w-full h-full object-contain opacity-75 hover:opacity-100 transition-opacity duration-500"
                                />
                            )}
                        </div>
                    );
                })}
            </div>

            <!-- Prev Button -->
            {hasSlider && (
                <button
                    class="slider-prev absolute left-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-black/50 border border-white/20 text-white/70 hover:text-white hover:bg-black/80 hover:border-white/40 transition-all duration-300 flex items-center justify-center cursor-pointer opacity-0 group-hover:opacity-100"
                    aria-label="Anterior"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="15 18 9 12 15 6"></polyline>
                    </svg>
                </button>
            )}

            <!-- Next Button -->
            {hasSlider && (
                <button
                    class="slider-next absolute right-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-black/50 border border-white/20 text-white/70 hover:text-white hover:bg-black/80 hover:border-white/40 transition-all duration-300 flex items-center justify-center cursor-pointer opacity-0 group-hover:opacity-100"
                    aria-label="Siguiente"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                </button>
            )}

            <!-- Dots -->
            {hasSlider && (
                <div class="absolute bottom-3 left-1/2 -translate-x-1/2 flex gap-2">
                    {project.images.map((_, i) => (
                        <button
                            class:list={[
                                "slider-dot w-2 h-2 rounded-full transition-all duration-300 cursor-pointer",
                                i === 0 ? "bg-white" : "bg-white/30 hover:bg-white/50",
                            ]}
                            data-index={i}
                            aria-label={`Slide ${i + 1}`}
                        />
                    ))}
                </div>
            )}
        </div>

        <!-- Description and Details -->
        <div
            class="flex flex-col lg:flex-row justify-between items-start gap-12"
        >
            <div class="w-full lg:w-2/3">
                <p
                    class="text-white/70 text-sm md:text-base leading-[1.8] font-mono text-justify"
                    set:html={project.descriptionHtml}
                    data-i18n={`proj_${project.id}_desc`}
                >
                </p>
                <div
                    class="mt-8 text-white/60 text-sm font-mono space-y-2 border-t border-white/10 pt-4"
                >
                    <p>
                        <span
                            class="text-white font-bold uppercase tracking-widest"
                            data-i18n="proj_tools">Herramientas :</span
                        >
                        {project.tools}
                    </p>
                    <p>
                        <span
                            class="text-white font-bold uppercase tracking-widest"
                            data-i18n="proj_analysis_label">Análisis :</span
                        >
                        {project.analysis}
                    </p>
                </div>
            </div>

            <div class="w-full lg:w-1/3 flex flex-col gap-3">
                {
                    project.links.map((link) => {
                        const isDashboard = link.i18nKey === "proj_link_powerbi";
                        return (
                            <a
                                href={link.url}
                                target="_blank"
                                rel="noopener noreferrer"
                                class={`border border-white/30 px-6 py-4 text-white uppercase tracking-[0.2em] text-[10px] md:text-xs text-center hover:bg-white hover:text-black transition-all cursor-pointer ${
                                    isDashboard ? "btn-dashboard" : ""
                                }`}
                                data-i18n={link.i18nKey}
                                data-dashboard-url={isDashboard ? link.url : undefined}
                                data-project-title={project.title}
                            >
                                {link.text}
                            </a>
                        );
                    })
                }
            </div>
        </div>
    </div>
</div>

<script>
    function initSliders() {
        const sliders = document.querySelectorAll('[data-slider="true"]');

        sliders.forEach((slider) => {
            const track = slider.querySelector('.slider-track') as HTMLElement;
            const slides = slider.querySelectorAll('.slider-slide');
            const dots = slider.querySelectorAll('.slider-dot');
            const prevBtn = slider.querySelector('.slider-prev');
            const nextBtn = slider.querySelector('.slider-next');
            let currentIndex = 0;
            const totalSlides = slides.length;

            function goToSlide(index: number) {
                if (index < 0) index = totalSlides - 1;
                if (index >= totalSlides) index = 0;

                const prevIndex = currentIndex;
                currentIndex = index;
                track.style.transform = `translateX(-${currentIndex * 100}%)`;
                dots.forEach((dot, i) => {
                    dot.classList.toggle('bg-white', i === currentIndex);
                    dot.classList.toggle('bg-white/30', i !== currentIndex);
                });

                // Pause previous video, play current if video
                const allSlides = Array.from(slides);
                const prevVideo = allSlides[prevIndex]?.querySelector('video');
                const currVideo = allSlides[currentIndex]?.querySelector('video');
                if (prevVideo && prevVideo !== currVideo) {
                    prevVideo.pause();
                }
                if (currVideo) {
                    currVideo.currentTime = 0;
                    currVideo.play().catch(() => {});
                }
            }

            prevBtn?.addEventListener('click', () => goToSlide(currentIndex - 1));
            nextBtn?.addEventListener('click', () => goToSlide(currentIndex + 1));

            dots.forEach((dot) => {
                dot.addEventListener('click', () => {
                    const index = parseInt(dot.getAttribute('data-index') || '0');
                    goToSlide(index);
                });
            });

            const firstVideo = slides[0]?.querySelector('video');
            if (firstVideo) {
                firstVideo.play().catch(() => {});
            }
        });
    }

    document.addEventListener('DOMContentLoaded', initSliders);
    document.addEventListener('astro:page-load', initSliders);
</script>
