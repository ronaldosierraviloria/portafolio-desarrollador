---
export interface Props {
    project: {
        id: string;
        title: string;
        subtitle: string;
        image1: string;
        image2: string;
        descriptionHtml: string;
        tools: string;
        analysis: string;
        type: "analysis" | "dashboard";
        links: {
            text: string;
            i18nKey: string;
            url: string;
        }[];
    };
}
const { project } = Astro.props;
---

<div
    class="w-full relative flex flex-col xl:flex-row gap-8 xl:gap-16 border-b border-white/10 pb-24 group"
>
    <!-- Big ID Background / Sidebar -->
    <div
        class="w-full xl:w-1/4 flex flex-col md:flex-row xl:flex-col justify-between xl:justify-start items-start gap-4"
    >
        <span
            class="text-white/10 text-[6rem] md:text-[8rem] xl:text-[10rem] font-['Beastly'] leading-none tracking-tighter select-none transition-colors duration-500 group-hover:text-white/30"
            >{project.id}
        </span>

        <div class="mt-0 xl:mt-8 flex flex-col gap-2">
            <span
                class="inline-block border border-white/20 px-4 py-1 rounded-full text-[10px] uppercase tracking-[0.2em] font-mono text-white/50 w-max"
                data-i18n="proj_featured"
            >
                Proyecto Destacado
            </span>
        </div>
    </div>

    <!-- Content -->
    <div class="w-full xl:w-3/4 flex flex-col">
        <!-- Title -->
        <div class="mb-8">
            <h2
                class="text-white text-2xl md:text-4xl font-bold uppercase tracking-widest leading-tight"
                data-i18n={`proj_${project.id}_title`}
            >
                {project.title}
            </h2>
            <h3
                class="text-white/50 text-xl md:text-2xl font-mono uppercase tracking-[0.2em] mt-2"
                data-i18n={`proj_${project.id}_subtitle`}
            >
                {project.subtitle}
            </h3>
        </div>

        <!-- Images split -->
        <div
            class={`flex flex-col sm:flex-row w-full gap-4 mb-10 ${
                project.type === "dashboard"
                    ? "h-[250px] md:h-[380px]"
                    : "h-[200px] md:h-[300px]"
            }`}
        >
            {
                project.type === "dashboard" ? (
                    <>
                        <div class="w-full sm:w-1/2 h-full bg-white/5 border border-white/10 relative overflow-hidden group/img">
                            {project.image1 ? (
                                <img
                                    src={project.image1}
                                    alt="Preview 1"
                                    class="w-full h-full object-contain opacity-70 group-hover/img:opacity-100 transition-all duration-700 group-hover/img:scale-105"
                                />
                            ) : (
                                <div class="w-full h-full flex items-center justify-center text-white/20 font-mono text-xs uppercase tracking-widest">
                                    Image 1
                                </div>
                            )}
                        </div>
                        <div class="w-full sm:w-1/2 h-full bg-white/5 border border-white/10 relative overflow-hidden group/img">
                            {project.image2 ? (
                                <img
                                    src={project.image2}
                                    alt="Preview 2"
                                    class="w-full h-full object-contain opacity-70 group-hover/img:opacity-100 transition-all duration-700 group-hover/img:scale-105"
                                />
                            ) : (
                                <div class="w-full h-full flex items-center justify-center text-white/20 font-mono text-xs uppercase tracking-widest">
                                    Image 2
                                </div>
                            )}
                        </div>
                    </>
                ) : (
                    <div class="w-full h-full bg-white/5 border border-white/10 relative overflow-hidden group/img">
                        {project.image1 ? (
                            <img
                                src={project.image1}
                                alt="Preview 1"
                                class="w-full h-full object-cover opacity-70 transition-all duration-700"
                            />
                        ) : (
                            <div class="w-full h-full flex items-center justify-center text-white/20 font-mono text-xs uppercase tracking-widest">
                                Analysis View
                            </div>
                        )}
                    </div>
                )
            }
        </div>

        <!-- Description and Details -->
        <div
            class="flex flex-col lg:flex-row justify-between items-start gap-12"
        >
            <div class="w-full lg:w-2/3">
                <p
                    class="text-white/70 text-sm md:text-base leading-[1.8] font-mono"
                    set:html={project.descriptionHtml}
                    data-i18n={`proj_${project.id}_desc`}
                >
                </p>
                <div
                    class="mt-8 text-white/60 text-sm font-mono space-y-2 border-t border-white/10 pt-4"
                >
                    <p>
                        <span
                            class="text-white font-bold uppercase tracking-widest"
                            data-i18n="proj_tools">Herramientas :</span
                        >
                        {project.tools}
                    </p>
                    <p>
                        <span
                            class="text-white font-bold uppercase tracking-widest"
                            data-i18n="proj_analysis_label">Análisis :</span
                        >
                        {project.analysis}
                    </p>
                </div>
            </div>

            <div class="w-full lg:w-1/3 flex flex-col gap-3">
                {
                    project.links.map((link) => {
                        const isDashboard = link.i18nKey === "proj_link_powerbi";
                        return (
                            <a
                                href={link.url}
                                class={`border border-white/30 px-6 py-4 text-white uppercase tracking-[0.2em] text-[10px] md:text-xs text-center hover:bg-white hover:text-black transition-all cursor-pointer ${
                                    isDashboard ? "btn-dashboard" : ""
                                }`}
                                data-i18n={link.i18nKey}
                                data-dashboard-url={isDashboard ? link.url : undefined}
                                data-project-title={project.title}
                            >
                                {link.text}
                            </a>
                        );
                    })
                }
            </div>
        </div>
    </div>
</div>
