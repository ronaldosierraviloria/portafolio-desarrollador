---
import ProjectCard from "./ProjectCard.astro";

import presentationImg from "../assets/ProjectContent/EDA-Inmobiliaria/Presentacion.png";
import FirstView from "../assets/ProjectContent/DigitalBurnout/Vista1.png";
import SecondView from "../assets/ProjectContent/DigitalBurnout/Vista2.png";
import presentacionP from "../assets/ProjectContent/PruebasAB/portada.png";

const projectsData = [
    {
        id: "01",
        title: "ANALISI EXPLORATORIO DE DATOS - INMOBILIARIA",
        subtitle: "EN COLOMBIA",
        image1: presentationImg.src,
        image2: "",
        type: "analysis",
        descriptionHtml: `Un análisis <span class="text-white font-bold border-b border-white/40 pb-0.5">de datos sobre inmuebles en venta en Colombia</span>, utilizando técnicas de <span class="text-white font-bold border-b border-white/40 pb-0.5">análisis exploratorio de datos (EDA)</span> para identificar patrones y tendencias en el mercado inmobiliario colombiano. Este análisis <span class="text-white font-bold border-b border-white/40 pb-0.5">resulta en una mejor comprensión del mercado</span> y proporciona información valiosa para inversores y compradores.`,
        tools: "Google Colab, Python, Librerias (Pandas, Numpy, Seaborn, Matplotlib), Google Slides",
        analysis: "Analisis Exploratorio, Estadistico y Visual.",
        links: [
            {
                text: "Full Deck",
                i18nKey: "proj_link_deck",
                url: "https://docs.google.com/presentation/d/1MpTObNH8DVqi5NeWxW8uQqXwQ2iBhUcMAUnet1f8ELE/edit?usp=sharing",
            },
            {
                text: "GitHub",
                i18nKey: "proj_link_github",
                url: "https://github.com/ronaldosierraviloria/AnalisisExploratorioDeInmobiliaria",
            },
            {
                text: "Google Colab",
                i18nKey: "proj_link_colab",
                url: "https://colab.research.google.com/drive/1_H1EdzMXILCjIQO1nPtSej9eImkc-GAI?usp=sharing",
            },
        ],
    },
    {
        id: "02",
        title: "PRUEBAS A/B TESTING",
        subtitle: "MARKETING",
        image1: presentacionP.src,
        image2: "",
        type: "analysis",
        descriptionHtml: `Realización de pruebas A/B para optimizar campañas de marketing digital. Comparación de variantes A y B para determinar qué elementos generan mayor engagement y conversión. Los resultados se utilizan para tomar decisiones basadas en datos y mejorar el rendimiento de futuras campañas.`,
        tools: "Visual Studio Code, Python, Librerias (Pandas, Numpy, Seaborn, Matplotlib), Google Slides",
        analysis: "Analisis de dos camapañas",
        links: [
            {
                text: "Full Deck",
                i18nKey: "proj_link_deck",
                url: "https://docs.google.com/presentation/d/15FofChjtZJQ5MZTFul7Hme7dSCjPtKGKnyp54nQqXsY/edit?usp=sharing",
            },
            {
                text: "GitHub",
                i18nKey: "proj_link_github",
                url: "https://github.com/ronaldosierraviloria/Pruebas-AB-Testing-Marketing-Dataset",
            },
        ],
    },
    {
        id: "03",
        title: "Digital Burnout & Productivity Analytics",
        subtitle: "Visualization",
        image1: FirstView.src,
        image2: SecondView.src,
        type: "dashboard",
        descriptionHtml: `Visualización sobre Cansancio Digital y Análisis de Productividad, para encontrar los causantes
de el cansancio digital y analizar la productividad de esta mediante el uso de diferentes variables, identificando cuales tienen un mayor modos de trabajos, trabajos, etc. Tienen o se ven afectados por este cansancio y si la productividad se ve afectada por este. Analizando los resultados observamos como la modalidad de trabajo Remota contiene el mayor numero de Fatiga mental por parte de los usuarios.`,
        tools: "Python, Power BI, PgAdmin4, Visual Studio Code",
        analysis: "Data Processing, Data Visualization, Data Analysis, SQL",
        links: [
            {
                text: "Live Dashboard",
                i18nKey: "proj_link_powerbi",
                url: "https://app.powerbi.com/view?r=eyJrIjoiNTc4YjU4OWMtM2M1MS00ZWM2LWFlZDctNzhmMGYwZGQ1NTZhIiwidCI6ImJlZjU3Y2ZhLWY1MzItNDU4Ny05ZTY4LWJhNDEyYTU1OTY0YiIsImMiOjR9",
            },
            {
                text: "Documentation",
                i18nKey: "proj_link_github",
                url: "https://github.com/ronaldosierraviloria/Digital-Burnout-And-Productivity-Analytics-",
            },
        ],
    },
];
---

<section
    id="proyectos"
    class="w-full py-16 md:py-32 bg-[#111111] relative z-20"
>
    <div class="max-w-[1400px] mx-auto px-4 md:px-8">
        <h2
            class="text-[8vw] md:text-[6vw] font-['Beastly'] uppercase tracking-widest text-center mb-16 text-[#e0e0e0]"
            data-i18n="proj_title"
        >
            Proyectos
        </h2>

        <!-- Toggle Controls -->
        <div class="flex justify-center mb-24">
            <div
                class="inline-flex p-1 bg-white/5 border border-white/10 rounded-full backdrop-blur-sm"
            >
                <button
                    class="project-toggle px-6 py-2 md:px-8 md:py-3 rounded-full text-[10px] md:text-xs uppercase tracking-[0.2em] transition-all duration-500 active-toggle"
                    data-category="analysis"
                >
                    <span data-i18n="proj_toggle_analysis"
                        >Análisis Estadísticos</span
                    >
                </button>
                <button
                    class="project-toggle px-6 py-2 md:px-8 md:py-3 rounded-full text-[10px] md:text-xs uppercase tracking-[0.2em] transition-all duration-500 text-white/40 hover:text-white"
                    data-category="dashboard"
                >
                    <span data-i18n="proj_toggle_dashboards">Dashboards</span>
                </button>
            </div>
        </div>

        <div class="projects-grid flex flex-col gap-24 md:gap-32">
            {
                projectsData.map((project) => (
                    <div
                        class="project-container opacity-0 translate-y-12"
                        data-type={project.type}
                        style={
                            project.type === "dashboard" ? "display: none;" : ""
                        }
                    >
                        <ProjectCard project={project} />
                    </div>
                ))
            }
        </div>
    </div>
</section>

<!-- Dashboard Modal -->
<dialog
    id="dashboard-modal"
    class="bg-transparent border-0 p-0 text-white w-full h-full max-w-none max-h-none overflow-hidden m-0 justify-center items-center backdrop:bg-black/90 backdrop:backdrop-blur-md z-[200] outline-none"
>
    <!-- Modal Container -->
    <div
        id="dashboard-modal-container"
        class="w-[95vw] h-[90vh] max-w-7xl bg-[#111111]/90 border border-white/10 rounded-2xl flex flex-col relative overflow-hidden backdrop-blur-xl shadow-2xl"
    >
        <!-- Header -->
        <div
            class="px-6 py-4 md:px-8 md:py-5 border-b border-white/10 flex justify-between items-center bg-[#181818]/60 backdrop-blur-md"
        >
            <div>
                <h3
                    id="dashboard-modal-title"
                    class="text-sm md:text-base font-bold tracking-wider uppercase font-mono text-white/90"
                >
                    Visualización
                </h3>
                <p
                    id="dashboard-modal-subtitle"
                    class="text-[9px] md:text-[10px] text-white/50 uppercase tracking-[0.2em] font-mono mt-0.5"
                >
                    Power BI Live Embed
                </p>
            </div>

            <!-- Close Button -->
            <button
                id="close-dashboard-modal"
                class="group relative flex items-center justify-center w-10 h-10 rounded-full border border-white/20 hover:border-white text-white/70 hover:text-white transition-all duration-300 cursor-pointer overflow-hidden"
                aria-label="Cerrar modal"
            >
                <div
                    class="absolute inset-0 bg-white/5 scale-0 group-hover:scale-100 transition-transform duration-300 rounded-full"
                >
                </div>
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="relative z-10 transition-transform duration-300 group-hover:rotate-90"
                >
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>

        <!-- Body / Content -->
        <div
            class="flex-1 w-full h-full relative bg-black/40 flex items-center justify-center"
        >
            <!-- Dynamic Loader -->
            <div
                id="dashboard-loader"
                class="absolute inset-0 flex flex-col items-center justify-center gap-4 bg-[#111111] z-10 transition-opacity duration-500"
            >
                <div
                    class="w-12 h-12 border-2 border-white/10 border-t-white rounded-full animate-spin"
                >
                </div>
                <p
                    class="text-xs uppercase tracking-[0.3em] font-mono text-white/50 animate-pulse"
                >
                    Conectando con Power BI...
                </p>
            </div>

            <!-- Fallback / Coming Soon screen -->
            <div
                id="dashboard-fallback"
                class="hidden absolute inset-0 flex flex-col items-center justify-center gap-6 bg-[#111111] z-10 p-8 text-center"
            >
                <div
                    class="p-6 bg-white/5 border border-white/10 rounded-full text-white/40 mb-2"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="40"
                        height="40"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="animate-pulse text-white/60"
                    >
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"
                        ></rect>
                        <line x1="9" y1="9" x2="15" y2="15"></line>
                        <line x1="15" y1="9" x2="9" y2="15"></line>
                    </svg>
                </div>
                <h4
                    class="text-base md:text-lg font-mono uppercase tracking-[0.2em] text-white"
                >
                    Dashboard no disponible
                </h4>
                <p
                    class="text-xs md:text-sm font-mono text-white/50 max-w-md leading-relaxed"
                >
                    Este dashboard está siendo actualizado o requiere
                    configuración. Vuelve a intentarlo más tarde.
                </p>
            </div>

            <!-- Iframe Container -->
            <iframe
                id="dashboard-iframe"
                title="Visualization"
                src=""
                frameborder="0"
                allowFullScreen="true"
                class="w-full h-full opacity-0 transition-opacity duration-700"
            ></iframe>
        </div>
    </div>
</dialog>

<style>
    .active-toggle {
        background-color: white;
        color: black;
    }
    #dashboard-modal {
        display: none;
    }
    #dashboard-modal[open] {
        display: flex;
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    function initAnimations() {
        const projectContainers = gsap.utils.toArray(
            ".project-container:not([style*='display: none'])",
        );

        projectContainers.forEach((container: any) => {
            gsap.to(container, {
                opacity: 1,
                y: 0,
                duration: 1.2,
                ease: "expo.out",
                scrollTrigger: {
                    trigger: container,
                    start: "top 85%",
                    toggleActions: "play none none reverse",
                },
            });
        });
    }

    // Toggle Logic
    const toggles = document.querySelectorAll(".project-toggle");
    const containers = document.querySelectorAll(".project-container");

    toggles.forEach((toggle) => {
        toggle.addEventListener("click", () => {
            const category = toggle.getAttribute("data-category");

            // Update buttons
            toggles.forEach((t) => {
                t.classList.remove("active-toggle");
                t.classList.add("text-white/40");
            });
            toggle.classList.add("active-toggle");
            toggle.classList.remove("text-white/40");

            // Filter projects with animation
            const tl = gsap.timeline();

            // 1. Fade out current
            tl.to(".project-container:not([style*='display: none'])", {
                opacity: 0,
                y: 20,
                duration: 0.4,
                ease: "power2.in",
                onComplete: () => {
                    // 2. Switch visibility
                    containers.forEach((container: any) => {
                        if (container.getAttribute("data-type") === category) {
                            container.style.display = "block";
                        } else {
                            container.style.display = "none";
                        }
                    });

                    // Reset scroll trigger
                    ScrollTrigger.refresh();
                },
            });

            // 3. Fade in new
            tl.to(`.project-container[data-type="${category}"]`, {
                opacity: 1,
                y: 0,
                duration: 0.8,
                stagger: 0.2,
                ease: "expo.out",
            });
        });
    });

    // Initial load
    initAnimations();

    // --- Dashboard Modal Logic ---
    const dashboardModal = document.getElementById(
        "dashboard-modal",
    ) as HTMLDialogElement | null;
    const modalContainer = document.getElementById("dashboard-modal-container");
    const modalTitle = document.getElementById("dashboard-modal-title");
    const closeDashboardBtn = document.getElementById("close-dashboard-modal");
    const dashboardIframe = document.getElementById(
        "dashboard-iframe",
    ) as HTMLIFrameElement | null;
    const dashboardLoader = document.getElementById("dashboard-loader");
    const dashboardFallback = document.getElementById("dashboard-fallback");

    function openModal(url: string, title: string) {
        if (!dashboardModal || !modalContainer) return;

        // Reset views
        if (dashboardIframe) {
            dashboardIframe.style.opacity = "0";
            dashboardIframe.src = "";
        }
        if (dashboardLoader) {
            dashboardLoader.classList.remove("hidden");
            dashboardLoader.style.opacity = "1";
        }
        if (dashboardFallback) dashboardFallback.classList.add("hidden");

        // Set Title
        if (modalTitle) {
            modalTitle.textContent = title;
        }

        // Open Dialog
        dashboardModal.showModal();

        // Animate Modal In
        gsap.fromTo(
            modalContainer,
            { scale: 0.9, opacity: 0 },
            {
                scale: 1,
                opacity: 1,
                duration: 0.5,
                ease: "expo.out",
                clearProps: "transform",
            },
        );

        // Check if URL is valid
        if (!url || url === "#") {
            // Show fallback immediately
            if (dashboardLoader) {
                dashboardLoader.style.opacity = "0";
                dashboardLoader.classList.add("hidden");
            }
            if (dashboardFallback) dashboardFallback.classList.remove("hidden");
        } else {
            // Load Iframe
            if (dashboardIframe) {
                dashboardIframe.src = url;

                // Show loader, then hide on load
                dashboardIframe.onload = () => {
                    if (dashboardLoader) {
                        gsap.to(dashboardLoader, {
                            opacity: 0,
                            duration: 0.3,
                            onComplete: () => {
                                if (dashboardIframe)
                                    dashboardIframe.style.opacity = "1";
                                dashboardLoader.classList.add("hidden");
                            },
                        });
                    } else {
                        dashboardIframe.style.opacity = "1";
                    }
                };
            }
        }
    }

    function closeModal() {
        if (!dashboardModal || !modalContainer) return;

        // Animate Modal Out
        gsap.to(modalContainer, {
            scale: 0.9,
            opacity: 0,
            duration: 0.4,
            ease: "power2.inOut",
            onComplete: () => {
                dashboardModal.close();
                // Clear iframe src to stop background processing
                if (dashboardIframe) {
                    dashboardIframe.src = "";
                    dashboardIframe.style.opacity = "0";
                }
            },
        });
    }

    // Attach click events to all dashboard buttons (event delegation)
    document.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        const btn = target.closest(".btn-dashboard");
        if (btn) {
            e.preventDefault();
            const url = btn.getAttribute("data-dashboard-url") || "#";
            const title =
                btn.getAttribute("data-project-title") || "Visualización";
            openModal(url, title);
        }
    });

    closeDashboardBtn?.addEventListener("click", closeModal);

    // Close on backdrop click
    dashboardModal?.addEventListener("click", (e) => {
        const dialogDimensions = dashboardModal.getBoundingClientRect();
        if (
            e.clientX < dialogDimensions.left ||
            e.clientX > dialogDimensions.right ||
            e.clientY < dialogDimensions.top ||
            e.clientY > dialogDimensions.bottom
        ) {
            closeModal();
        }
    });

    // Close on ESC key (override default to animate first)
    dashboardModal?.addEventListener("cancel", (e) => {
        e.preventDefault(); // Prevent immediate close
        closeModal();
    });
</script>
