import loginimg from "../assets/ProjectContent/cecar-project/Pag (1).jpeg";
import indeximg from "../assets/ProjectContent/cecar-project/Pag (2).jpeg";
import gestorimg from "../assets/ProjectContent/cecar-project/gestor.jpeg";
import evaluadorimg from "../assets/ProjectContent/cecar-project/evaluador.jpeg";
import loginlogiticaimg from "../assets/ProjectContent/logistica-project/logindashboard.png";
import homeimg from "../assets/ProjectContent/logistica-project/homedashboard.png";
import logisticaimg from "../assets/ProjectContent/logistica-project/logisticadashboard.png";
import activosimg from "../assets/ProjectContent/logistica-project/activosdashboard.png";
import configuracionimg from "../assets/ProjectContent/logistica-project/configuraciondashboard.png";
import chatbotimg from "../assets/chatbot/chatbotimg.png";
import chatbotresponseimg from "../assets/chatbot/chatbotresponse.png";
import geminiapimg from "../assets/chatbot/geminiapi.png";
import dockerimage from "../assets/chatbot/dockerimage.png";
const projectsData = [
    {
        id: "01",
        title: "Plataforma Institucional",
        subtitle:
            "Software para la gestión, asignación y evaluación de proyectos de grado en la Corporación Universitaria Del Caribe CECAR",
        images: [loginimg.src, indeximg.src, gestorimg.src, evaluadorimg.src],
        descriptionHtml:
            "La plataforma cuenta con una autenticación por Roles (Administrador,  Gestor, Evaluador), Donde cada uno tiene diferente funcionalidades. <span class='text-white font-bold border-b border-white/40 pb-0.5'>Administrador:</span> Gestiona los usuarios, áreas, tipos de trabajo, estudiantes, Asigna Evaluadores, Tiene trazabilidad de cada proyecto. <span class='text-white font-bold border-b border-white/40 pb-0.5'>Gestor:</span> Gestiona los documentos, Asigna rubricas de evaluación. <span class='text-white font-bold border-b border-white/40 pb-0.5'>Evaluador:</span> Evalúa los proyectos. La plataforma esta basada en la Arquitectura <span class='text-white font-bold border-b border-white/40 pb-0.5'>MVC (Model,View,Controller)</span> y cuenta con un sistema de notificaciones interno.",
        tools: "Vite,Laravel, PostgreSQL,TailwindCSS, AlpineJs, Flowbite, ApexCharts",
        analysis:
            "Arquitectura MVC, Base de Datos Relacional, Frontend SPA, Sistema de Notificaciones",
        links: [
            {
                text: "View Application",
                i18nKey: "proj_link_deck",
                url: "https://cecar-project.vercel.app/login",
            },
            {
                text: "GitHub",
                i18nKey: "proj_link_github",
                url: "https://github.com/ronaldosierraviloria/cecar-project",
            },
        ],
    },
    {
        id: "02",
        title: "Dashboard Web para empresa de Logistica.",
        subtitle: "Logistica",
        images: [
            loginlogiticaimg.src,
            homeimg.src,
            logisticaimg.src,
            activosimg.src,
            configuracionimg.src,
        ],
        descriptionHtml: `El objetivo de este proyecto es desarrollar una aplicación web que sirva como un dashboard interactivo para una empresa de logística. La plataforma permitirá a los usuarios visualizar y analizar datos relacionados con el transporte de paquetería y envíos. Los datos serán cargados manualmente por el usuario en archivos Excel (xlsx, CSV) y la aplicación procesará la información para generar visualizaciones gráficas y estadísticas que faciliten el seguimiento de envíos y la toma de decisiones. La interfaz será intuitiva, permitiendo una navegación fluida entre las diferentes secciones del dashboard, ademas de ser totalmente responsive y adaptada a dispositivos moviles.`,
        tools: "HTML5, TailwindCSS, Python, Flask, SQLite, Excel, Pandas, Matplotlib",
        analysis:
            "Sistema De Notificaciones, Responsive, Capacidad de escalar.",
        links: [
            {
                text: "Full Deck",
                i18nKey: "proj_link_deck",
                url: "https://logistica-project-theta.vercel.app/login",
            },
            {
                text: "GitHub",
                i18nKey: "proj_link_github",
                url: "http://github.com/ronaldosierraviloria/logistica-project",
            },
        ],
    },
    {
        id: "03",
        title: "Chatbot Web Integrando Modelo de Inteligencia Artificial",
        subtitle:
            "Automatización Servicio de recepción de pedidos a domicilios en un restaurante.",
        images: [
            "/chatbotfuncion.mp4",
            chatbotimg.src,
            dockerimage.src,
            chatbotresponseimg.src,
            geminiapimg.src,
        ],
        descriptionHtml:
            "Chatbot web para automatizar el proceso de recepcion de pedidos basado en una arquitectura de <span class='text-white font-bold border-b border-white/40 pb-0.5'>Microservicios</span>, ademas de estar contenerizado en <span class='text-white font-bold border-b border-white/40 pb-0.5'>Docker</span>, respuestas automaticas mediante la <span class='text-white font-bold border-b border-white/40 pb-0.5'>Inteligencia Artificial Gemini 3.5 Flash</span> modelo gratuito que solamente renderiza texto, perfecto para respuestas automaticas.",
        tools: "Python, FastApi, GemeiniAPI, Microservicios, Docker, JSON",
        analysis: "Inteligencia Artificial, Automatización",
        links: [
            {
                text: "Documentation",
                i18nKey: "proj_link_github",
                url: "",
            },
        ],
