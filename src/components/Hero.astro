---

---

<header
    class="relative h-screen w-full flex flex-col items-center justify-center overflow-visible bg-transparent -mt-10 md:-mt-0"
>
    <div class="relative z-10 text-center w-full px-4">
        <h1
            class="hero-title w-full flex justify-center items-center overflow-visible"
        >
            <svg
                viewBox="0 0 1000 180"
                class="w-full max-w-[90vw] h-auto drop-shadow-2xl"
            >
                <text
                    x="50%"
                    y="50%"
                    text-anchor="middle"
                    dominant-baseline="middle"
                    class="drawing-text font-['Beastly'] text-[150px] md:text-[180px] uppercase fill-transparent stroke-[#e0e0e0] stroke-[1.5px]"
                    style="stroke-dasharray: 1200; stroke-dashoffset: 1200; stroke-linejoin: round; letter-spacing: 0.05em;"
                >
                    RONALDO
                </text>
            </svg>
            <span
                class="char star-char inline-block opacity-0 ml-[-5vw] md:ml-[-2vw] mb-[1.5vw]"
            >
                <svg
                    viewBox="0 0 24 24"
                    class="w-[3vw] md:w-[4vw] fill-[#e0e0e0] spin-star"
                >
                    <path
                        d="M12,0L14.4,9.6L24,12L14.4,14.4L12,24L9.6,14.4L0,12L9.6,9.6L12,0Z"
                    ></path>
                </svg>
            </span>
        </h1>
        <p
            class="hero-subtitle text-xs md:text-sm uppercase tracking-[0.6em] text-white/60 mt-2 md:mt-4 opacity-0 translate-y-4"
            data-i18n="hero_subtitle"
        >
            Estudiante Ingenieria De Sistemas - Analista De Datos Junior.
        </p>

        <!-- Action Buttons -->
        <div
            class="flex gap-4 md:gap-6 mt-6 justify-center z-30 relative w-full"
        >
            <a
                href="#proyectos"
                data-i18n="hero_projects_btn"
                class="hero-action-btn opacity-0 translate-y-4 px-6 md:px-8 py-3 bg-white text-black uppercase tracking-widest text-xs md:text-sm font-bold hover:bg-[#E0E0E0] transition-colors cursor-pointer"
            >
                Proyectos
            </a>
            <button
                id="open-cv-modal"
                data-i18n="hero_cv_btn"
                class="hero-action-btn opacity-0 translate-y-4 px-6 md:px-8 py-3 border border-white text-white uppercase tracking-widest text-xs md:text-sm hover:bg-white/10 transition-colors backdrop-blur-sm cursor-pointer"
            >
                Descargar CV
            </button>
        </div>
    </div>

    <!-- Technologies Row -->
    <div class="flex flex-col items-center mt-8 md:mt-10 z-20 w-full px-4">
        <h3
            class="tech-title opacity-0 translate-y-4 text-xs md:text-sm uppercase tracking-[0.4em] text-white/50 mb-4 font-mono text-center"
            data-i18n="tech_title"
        >
            Tecnologías
        </h3>
        <div
            class="technologies flex flex-wrap justify-center items-center gap-3 md:gap-4 max-w-[85vw]"
        >
            {
                [
                    "Python",
                    "SQL",
                    "Power BI",
                    "Excel",
                    "Amazon Web Services",
                ].map((tech) => (
                    <span class="tech-item opacity-0 translate-y-8 text-[10px] md:text-xs font-mono uppercase tracking-widest text-white/80 border border-white/20 px-4 py-2 md:px-6 md:py-3 rounded-full backdrop-blur-sm hover:bg-white/10 hover:scale-105 transition-all cursor-default">
                        {tech}
                    </span>
                ))
            }
        </div>
    </div>

    <!-- Scroll Indicator -->
    <div
        class="scroll-indicator absolute bottom-4 md:bottom-6 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-0 text-white z-30"
    >
        <span
            class="text-[9px] uppercase tracking-[0.3em] font-medium text-white/50"
            >Scroll</span
        >
        <div class="mouse-icon">
            <svg
                width="20"
                height="32"
                viewBox="0 0 24 40"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
            >
                <rect
                    x="1"
                    y="1"
                    width="22"
                    height="38"
                    rx="11"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-opacity="0.5"></rect>
                <circle
                    class="mouse-dot"
                    cx="12"
                    cy="12"
                    r="1.5"
                    fill="currentColor"></circle>
            </svg>
        </div>
    </div>

    <!-- CV Modal -->
    <dialog
        id="cv-modal"
        class="bg-[#111111] border border-white/20 p-8 text-white backdrop:bg-black/80 backdrop:backdrop-blur-sm m-auto z-[200]"
    >
        <div class="flex flex-col gap-6 w-full max-w-sm">
            <h3
                class="text-xl font-mono uppercase tracking-widest text-center mb-2"
                data-i18n="cv_modal_title"
            >
                Selecciona el Idioma
            </h3>
            <div class="flex flex-col gap-4">
                <a
                    href="/cv-es.pdf"
                    target="_blank"
                    data-i18n="cv_es"
                    class="border border-white/50 hover:bg-white/10 px-6 py-3 text-center uppercase tracking-widest text-sm transition-colors cursor-pointer"
                    >CV en Español</a
                >
                <a
                    href="/cv-en.pdf"
                    target="_blank"
                    data-i18n="cv_en"
                    class="border border-white/50 hover:bg-white/10 px-6 py-3 text-center uppercase tracking-widest text-sm transition-colors cursor-pointer"
                    >CV en Inglés</a
                >
            </div>
            <button
                id="close-modal"
                data-i18n="cv_close"
                class="mt-4 text-white/50 hover:text-white uppercase tracking-widest text-xs cursor-pointer"
                >Cerrar</button
            >
        </div>
    </dialog>
</header>

<script>
    import { gsap } from "gsap";

    // Mouse dot animation
    gsap.to(".mouse-dot", {
        y: 15,
        opacity: 0,
        duration: 1.5,
        repeat: -1,
        ease: "power2.inOut",
    });

    // Float animation for scroll indicator
    gsap.to(".scroll-indicator", {
        y: 5,
        duration: 2,
        repeat: -1,
        yoyo: true,
        ease: "sine.inOut",
    });

    // Modal Logic
    const cvModal = document.getElementById("cv-modal");
    const openCvModalBtn = document.getElementById("open-cv-modal");
    const closeModalBtn = document.getElementById("close-modal");

    openCvModalBtn?.addEventListener("click", () => {
        if (
            cvModal &&
            typeof (cvModal as HTMLDialogElement).showModal === "function"
        ) {
            (cvModal as HTMLDialogElement).showModal();
        }
    });

    closeModalBtn?.addEventListener("click", () => {
        if (
            cvModal &&
            typeof (cvModal as HTMLDialogElement).close === "function"
        ) {
            (cvModal as HTMLDialogElement).close();
        }
    });

    // Close on backdrop click
    cvModal?.addEventListener("click", (e) => {
        const dialogDimensions = cvModal.getBoundingClientRect();
        if (
            e.clientX < dialogDimensions.left ||
            e.clientX > dialogDimensions.right ||
            e.clientY < dialogDimensions.top ||
            e.clientY > dialogDimensions.bottom
        ) {
            if (typeof (cvModal as HTMLDialogElement).close === "function") {
                (cvModal as HTMLDialogElement).close();
            }
        }
    });
</script>
