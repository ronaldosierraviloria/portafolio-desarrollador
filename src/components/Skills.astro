---

<section
    id="skills"
    class="w-full py-24 bg-[#111111] border-t border-white/5 relative z-20 overflow-hidden"
>
    <div class="max-w-[1400px] mx-auto px-6 md:px-12 lg:px-24">
        <div class="mb-24">
            <h2
                class="text-[12vw] md:text-[8vw] leading-[0.8] font-['Beastly'] uppercase tracking-wider text-[#e0e0e0]"
                data-i18n="skills_header"
            >
                Technical Skills
            </h2>
            <div class="w-24 h-[2px] bg-white/30 mt-8"></div>
        </div>
        <div
            class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-0 border-t border-white/10"
        >
            {
                skills.map((cat, idx) => (
                    <div
                        class={`skills-cat flex flex-col gap-10 p-8 md:p-12 ${(idx + 1) % 3 !== 0 ? "lg:border-r border-white/10" : ""} ${idx % 2 === 0 ? "md:border-r" : ""} border-b border-white/10`}
                    >
                        <h3
                            class="text-xs md:text-sm font-mono text-white/40 uppercase tracking-[0.4em] leading-relaxed"
                            data-i18n={cat.i18nCategory}
                        >
                            {cat.category}
                        </h3>

                        <ul class="flex flex-col gap-8">
                            {cat.items.map((item) => (
                                <li class="flex items-center gap-5 group">
                                    <div class="w-10 h-10 md:w-12 md:h-12 rounded-full bg-white/5 border border-white/10 flex items-center justify-center p-2.5 transition-all duration-500 group-hover:bg-white/10 group-hover:border-white/30 group-hover:scale-110">
                                        <div
                                            class="w-full h-full text-white/70 group-hover:text-white transition-colors"
                                            set:html={icons[item.icon]}
                                        />
                                    </div>
                                    <span class="text-base md:text-lg font-['JHCRasbora'] text-white/60 group-hover:text-white transition-colors tracking-wide">
                                        {item.name}
                                    </span>
                                </li>
                            ))}
                        </ul>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const tlSkills = gsap.timeline({
        scrollTrigger: {
            trigger: "#skills",
            start: "top 80%",
        },
    });

    tlSkills
        .from("#skills h2", {
            y: 100,
            skewY: 7,
            opacity: 0,
            duration: 1.5,
            ease: "power4.out",
        })
        .from(
            "#skills .w-24",
            {
                scaleX: 0,
                transformOrigin: "left",
                duration: 1,
                ease: "power3.out",
            },
            "-=1",
        )
        .from(
            ".skills-cat",
            {
                opacity: 0,
                duration: 1,
                stagger: 0.1,
            },
            "-=0.8",
        )
        .from(
            ".skills-cat h3",
            {
                y: 20,
                opacity: 0,
                duration: 0.8,
                stagger: 0.1,
                ease: "power2.out",
            },
            "-=1",
        )
        .from(
            ".skills-cat li",
            {
                y: 40,
                opacity: 0,
                scale: 0.9,
                duration: 0.8,
                stagger: {
                    each: 0.05,
                    from: "start",
                },
                ease: "back.out(1.7)",
            },
            "-=0.6",
        );
</script>
