---

<section
    id="skills"
    class="w-full py-24 bg-[#111111] border-t border-white/5 relative z-20 overflow-hidden"
>
    <div class="max-w-[1400px] mx-auto px-6 md:px-12 lg:px-24">
        <div class="mb-24">
            <h2
                class="text-[12vw] md:text-[8vw] leading-[0.8] font-['Beastly'] uppercase tracking-wider text-white"
                data-i18n="skills_header"
            >
                Technical Skills
            </h2>
            <div class="w-24 h-[2px] bg-white/40 mt-8"></div>
        </div>
        <div
            class="grid grid-cols-1 md:grid-cols-2 gap-6"
        >
            {
                skills.map((cat) => (
                    <div
                        class="skills-cat flex flex-col gap-8 p-8 md:p-10 bg-[#161616] border border-white/15 rounded-2xl transition-all duration-500 hover:border-white/40 hover:bg-[#1c1c1c] hover:shadow-[0_0_30px_rgba(255,255,255,0.05)]"
                    >
                        <h3
                            class="text-xs md:text-sm font-mono text-white/90 font-bold uppercase tracking-[0.3em] leading-relaxed border-b border-white/10 pb-4"
                            data-i18n={cat.i18nCategory}
                        >
                            {cat.category}
                        </h3>

                        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                            {cat.items.map((item) => (
                                <li class="flex items-center gap-4 group cursor-default">
                                    <div class="w-11 h-11 rounded-xl bg-white/10 border border-white/20 flex items-center justify-center p-2.5 transition-all duration-300 group-hover:bg-white group-hover:text-black group-hover:scale-110 group-hover:shadow-[0_0_20px_rgba(255,255,255,0.4)]">
                                        <div
                                            class="w-full h-full text-white group-hover:text-black transition-colors"
                                            set:html={icons[item.icon]}
                                        />
                                    </div>
                                    <span class="text-base font-['JHCRasbora'] text-white font-medium group-hover:text-white transition-colors tracking-wide">
                                        {item.name}
                                    </span>
                                </li>
                            ))}
                        </ul>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    function initSkillsAnimation() {
        const mm = gsap.matchMedia();

        mm.add("(prefers-reduced-motion: reduce)", () => {
            gsap.set(["#skills h2", "#skills .w-24", ".skills-cat"], { opacity: 1, y: 0, scale: 1 });
        });

        mm.add("(prefers-reduced-motion: no-preference)", () => {
            gsap.fromTo(
                "#skills h2",
                { opacity: 0, y: 40 },
                {
                    opacity: 1,
                    y: 0,
                    duration: 1,
                    ease: "power4.out",
                    scrollTrigger: {
                        trigger: "#skills",
                        start: "top 90%",
                    },
                }
            );

            gsap.fromTo(
                ".skills-cat",
                { opacity: 0, y: 30 },
                {
                    opacity: 1,
                    y: 0,
                    duration: 0.8,
                    stagger: 0.15,
                    ease: "power3.out",
                    scrollTrigger: {
                        trigger: "#skills",
                        start: "top 85%",
                    },
                }
            );
        });
    }

    if (document.readyState === "complete") {
        initSkillsAnimation();
    } else {
        window.addEventListener("DOMContentLoaded", initSkillsAnimation);
    }

    window.addEventListener("page-loaded", () => {
        ScrollTrigger.refresh();
    });
</script>
