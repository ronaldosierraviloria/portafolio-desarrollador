---

---

<section
    id="proyecto-destacado"
    class="w-full py-16 md:py-16 bg-[#111111] relative z-20"
>
    <div class="max-w-[1400px] mx-auto px-4 md:px-8">
        <h2
            class="text-[8vw] md:text-[6vw] font-['Beastly'] uppercase tracking-widest text-center mb-16 text-[#e0e0e0]"
            data-i18n="featured_title"
        >
            Proyecto Destacado
        </h2>

        <div
            class="featured-content w-full relative flex flex-col xl:flex-row gap-8 xl:gap-16 border-b border-white/10 pb-24"
        >
            
            <div
                class="w-full xl:w-1/4 flex flex-col md:flex-row xl:flex-col justify-between xl:justify-start items-start gap-4"
            >
                <span
                    class="text-white/10 text-[6rem] md:text-[8rem] xl:text-[10rem] font-['Beastly'] leading-none tracking-tighter select-none"
                    >★</span
                >

                <div class="mt-0 xl:mt-8 flex flex-col gap-2">
                    <span
                        class="inline-block border border-white/20 px-4 py-1 rounded-full text-[10px] uppercase tracking-[0.2em] font-mono text-white/50 w-max"
                        data-i18n="featured_badge"
                    >
                        Proyecto Destacado
                    </span>
                </div>
            </div>

            <!-- Right: Content -->
            <div class="w-full xl:w-3/4 flex flex-col">
                <!-- Title -->
                <div class="mb-8">
                    <h3
                        class="text-white text-2xl md:text-4xl font-bold uppercase tracking-widest leading-tight"
                        data-i18n="featured_project_title"
                    >
                        Automatización pipeline de datos en AWS
                    </h3>
                    <h4
                        class="text-white/50 text-xl md:text-2xl font-mono uppercase tracking-[0.2em] mt-2"
                        data-i18n="featured_project_subtitle"
                    >
                        Automatización & Visualización de Datos
                    </h4>
                </div>

                <!-- Images split -->
                <div
                    class="flex flex-col sm:flex-row w-full gap-4 mb-10"
                >
                    <div
                        class="w-full sm:w-1/2 h-full bg-white/5 border border-white/10 relative overflow-hidden group/img"
                    >
                        <img
                            src="/Arquitectura.jpg"
                            alt="Preview 1"
                            class="w-full h-full object-contain opacity-70 group-hover/img:opacity-100 transition-all duration-700 group-hover/img:scale-105"
                        />
                    </div>

                </div>

                <!-- Description -->
                <div
                    class="flex flex-col lg:flex-row justify-between items-start gap-12"
                >
                    <div class="w-full lg:w-2/3">
                        <p
                            class="text-white/70 text-sm md:text-base leading-[1.8] font-mono"
                            data-i18n="featured_project_desc"
                        >Proyecto en etapa de desarrollo enfocado en la creación de un
                            <span
                                class="text-white font-bold border-b border-white/40 pb-0.5"
                                >
                                     pipeline de datos automatizado en AWS 
                                </span >
                                para el análisis de datos y visualizacion en tiempo real.
                        </p>
                        <div
                            class="mt-8 text-white/60 text-sm font-mono space-y-2 border-t border-white/10 pt-4"
                        >
                            <p>
                                <span
                                    class="text-white font-bold uppercase tracking-widest"
                                    data-i18n="proj_tools"
                                    >Herramientas :</span
                                >
                                FrontEnd: React, Power BI, Amazon Web Services (AWS)
                            </p>
                            <p>
                                <span
                                    class="text-white font-bold uppercase tracking-widest"
                                    data-i18n="proj_analysis_label"
                                    >Análisis :</span
                                >
                                Procesamiento de datos, Automatización, Visualización de datos, Análisis en tiempo real
                            </p>
                        </div>
                    </div>

                    <div class="w-full lg:w-1/3 flex flex-col gap-3">
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    gsap.fromTo(
        ".featured-content",
        { opacity: 0, y: 80 },
        {
            opacity: 1,
            y: 0,
            duration: 1.2,
            ease: "expo.out",
            scrollTrigger: {
                trigger: "#proyecto-destacado",
                start: "top 80%",
            },
        },
    );
</script>
