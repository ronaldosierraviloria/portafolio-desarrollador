---
import "../styles/global.css";
import MainLayout from "../layouts/MainLayout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import Marquee from "../components/Marquee.astro";
import About from "../components/About.astro";
import Skills from "../components/Skills.astro";
import Experience from "../components/Experience.astro";
import Projects from "../components/Projects.astro";
import Contact from "../components/Contact.astro";
import FeaturedProject from "../components/FeaturedProject.astro";
import Certificate from "../components/Certificate.astro";
---

<MainLayout title="Ronaldo Sierra - Portfolio">
    <Navbar />
    <main>
        <Hero />

        <Marquee text1="REACT - AWS" text2="APIs REST - Python - Docker" />

        <About />
        <Skills />
        <Experience />
        <FeaturedProject />
        <Projects />
        <Certificate />
        <section
            class="phrase-section py-8 overflow-hidden bg-transparent select-none relative z-20"
        >
            <div class="marquee-phrase-row flex whitespace-nowrap">
                {
                    Array.from({ length: 6 }).map(() => (
                        <span class="text-[4vw] md:text-[5vw] font-['JHCRasbora'] font-bold uppercase leading-none px-6 text-[#e0e0e0]">
                            "IT'S NEVER LUCK, IT'S ALWAYS GOD."{" "}
                            <span class="text-[#e0e0e0]/50">—</span>
                        </span>
                    ))
                }
            </div>
        </section>

        <Contact />
    </main>
</MainLayout>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import Lenis from "lenis";

    // Initialize Smooth Scroll
    const lenis = new Lenis();

    lenis.on("scroll", ScrollTrigger.update);

    gsap.ticker.add((time) => {
        lenis.raf(time * 1000);
    });

    gsap.ticker.lagSmoothing(0);

    gsap.registerPlugin(ScrollTrigger);

    // Entrance animation after preloader with gsap.matchMedia for accessibility & responsiveness
    window.addEventListener("page-loaded", () => {
        const mm = gsap.matchMedia();

        mm.add({
            isDesktop: "(min-width: 768px)",
            reduceMotion: "(prefers-reduced-motion: reduce)"
        }, (context) => {
            const { reduceMotion } = context.conditions || {};

            if (reduceMotion) {
                gsap.set(".drawing-text", { strokeDashoffset: 0, fill: "#e0e0e0" });
                gsap.set([".star-char", ".hero-subtitle", ".hero-action-btn", ".tech-title", ".tech-item", ".nav-item"], { opacity: 1, y: 0 });
                return;
            }

            const tl = gsap.timeline({ defaults: { ease: "power4.out" } });

            // 1. Draw Hero Title SVG
            tl.to(".drawing-text", {
                strokeDashoffset: 0,
                duration: 2.2,
                ease: "power2.inOut",
            });

            // 1.2 Fill Hero Title SVG
            tl.to(
                ".drawing-text",
                {
                    fill: "#e0e0e0",
                    duration: 0.8,
                    ease: "power1.inOut",
                },
                "-=1.0",
            );

            // 1.3 Show Star
            tl.to(
                ".star-char",
                {
                    autoAlpha: 1,
                    duration: 0.8,
                    ease: "back.out(2)",
                },
                "-=0.5",
            );

            // 2. Animate Subtitle
            tl.to(
                ".hero-subtitle",
                {
                    autoAlpha: 1,
                    y: 0,
                    duration: 1.2,
                    ease: "expo.out",
                },
                "-=1.2",
            );

            // 2.5. Animate Action Buttons
            tl.to(
                ".hero-action-btn",
                {
                    autoAlpha: 1,
                    y: 0,
                    duration: 1.0,
                    stagger: 0.1,
                    ease: "expo.out",
                },
                "-=1.0",
            );

            // 3. Animate Technologies
            tl.to(
                ".tech-title",
                {
                    autoAlpha: 1,
                    y: 0,
                    duration: 0.8,
                    ease: "expo.out",
                },
                "-=1.0",
            );

            tl.to(
                ".tech-item",
                {
                    autoAlpha: 1,
                    y: 0,
                    duration: 1.0,
                    stagger: 0.08,
                    ease: "expo.out",
                },
                "-=0.7",
            );

            // 4. Animate Navbar items
            tl.to(
                ".nav-item",
                {
                    autoAlpha: 1,
                    y: 0,
                    duration: 0.8,
                    stagger: 0.08,
                },
                "-=0.8",
            );

            // 5. Animate Scroll indicator
            tl.to(
                ".scroll-indicator",
                {
                    autoAlpha: 0.5,
                    y: 0,
                    duration: 0.8,
                },
                "-=0.5",
            );

            // Marquee Scroll Animations
            gsap.to(".marquee-row-1", {
                xPercent: 30,
                ease: "none",
                scrollTrigger: {
                    trigger: ".marquee-section",
                    start: "top bottom",
                    end: "bottom top",
                    scrub: true,
                },
            });

            gsap.to(".marquee-row-2", {
                xPercent: -30,
                ease: "none",
                scrollTrigger: {
                    trigger: ".marquee-section",
                    start: "top bottom",
                    end: "bottom top",
                    scrub: true,
                },
            });

            // Phrase Marquee Animation
            gsap.to(".marquee-phrase-row", {
                xPercent: -20,
                ease: "none",
                scrollTrigger: {
                    trigger: ".phrase-section",
                    start: "top bottom",
                    end: "bottom top",
                    scrub: true,
                },
            });
        });
    });
</script>
